<launch>

    <arg name="load_chassis" default="true"/>
    <arg name="paused" default="false"/>
    <arg name="roller_type" default="simple" description="simple or realistic"/>

    <!--param name="robot_description" command="$(find xacro)/xacro $(find rm_description)/urdf/hero/hero.urdf.xacro
         load_chassis:=$(var load_chassis)
         use_simulation:=true roller_type:=$(var roller_type)"/-->

    <!-- We resume the logic in empty_world.launch, changing only the name of the world to be launched -->
    <include file="$(find-pkg-share gazebo_ros)/launch/gazebo.launch.py">
        <arg name="paused" value="$(var paused)"/>
        <arg name="world_name" value="$(find-pkg-share gazebo_ros)/worlds/gazebo.launch.py"/>
    </include>

    <!-- push robot_description to factory and spawn robot in gazebo -->
    <node name="spawn_urdf" 
          exec="spawn_entity.py" 
          pkg="gazebo_ros" 
          args="-topic robot_description -entity hero -z 0.5" 
          output="screen">
          <param 
          name="robot_description" 
          value="$(command '/opt/ros/humble/lib/xacro/xacro /home/ciler/simple_chassis_controller/src/rm_description-1/urdf/hero/hero.urdf.xacro
         load_chassis:=$(var load_chassis)
         use_simulation:=true roller_type:=$(var roller_type)')"/>
    </node>

</launch>
